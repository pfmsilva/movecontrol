// MoveControl — schema da base de dados
// Rastreio de movimentação de equipamentos entre datacenters via QR Code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres — necessário para correr em Vercel (funções serverless têm
  // sistema de ficheiros efémero, por isso SQLite não funciona em produção).
  // Aponta DATABASE_URL para uma instância Postgres, tanto em dev como em prod
  // (ex: Vercel Postgres / Neon / Supabase — ver README).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Equipamento a movimentar. O hostname é o ID Único usado no QR Code.
/// Campos alinhados com a "Ficha de Equipamento" (formulário em papel usado
/// na migração física) para que a Vista de Impressão a possa reproduzir.
model Equipment {
  id           String      @id @default(cuid())
  hostname     String      @unique
  model        String?
  serialNumber String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scans        ScanEvent[]

  /// Identificador da "wave"/lote de migração a que este equipamento pertence.
  wave String?

  // — Dados do Equipamento —
  equipmentType   String? // Tipo Equipamento
  manufacturer    String? // Fabricante
  assetTag        String? // Etiqueta
  kvm             String? // KVM
  powerCables     String? // Cabos Power
  specialCables   String? // Cabos Especiais
  arms            String? // Braços
  powerLocation   String? // Localização Power
  cableConnection String? // Ligação Cabos
  rails           String? // Calhas

  // — Localização de Origem —
  originDatacenter String?
  originEp         String?
  originIsland     String? // Ilha
  originRack       String? // Bastidor
  originPosition   String? // Posição

  // — Localização de Destino —
  destinationDatacenter String?
  destinationIpTelecom  String? // IP Telecom
  destinationIsland     String?
  destinationRack       String?
  destinationPosition   String?

  ports PortConnection[]

  @@index([hostname])
}

/// Uma linha da tabela "Portas Ativas" da Ficha de Equipamento: um cabo/porta
/// ligando o equipamento de origem ao de destino (e respetivo patch panel).
model PortConnection {
  id          String    @id @default(cuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  order       Int // posição na tabela (1, 2, 3, …)

  /// Tipo de porta usada neste cabo.
  portType PortType?

  etiquetaOrigem       String? // Etiqueta Origem
  portaEtiquetaDestino String? // Porta/Etiqueta Equipamento Destino
  patchPanelOrigem     String? // Porta Patch Panel — Origem
  patchPanelDestino    String? // Porta Patch Panel — Destino

  @@index([equipmentId])
}

enum PortType {
  RJ45
  FIBRA
  OUTRAS
}

/// Ponto de controlo do processo de migração (ex: "Saída Origem",
/// "Em Trânsito", "Chegada Destino", "Instalado no Rack").
/// `order` define a posição na timeline — o maior valor é considerado
/// o checkpoint final (equipamento "Concluído").
model Checkpoint {
  id          String      @id @default(cuid())
  name        String
  order       Int         @unique
  description String?
  createdAt   DateTime    @default(now())
  scans       ScanEvent[]

  /// Utilizadores (VALIDATOR) autorizados a assumir este checkpoint.
  validators  User[]      @relation("ValidatorCheckpoints")
}

/// Papel de acesso do utilizador na aplicação.
/// - ADMIN: controlo total (utilizadores, checkpoints, equipamentos, scans).
/// - CONTROLLER: vê tudo exceto utilizadores; cria/apaga equipamentos e checkpoints; faz scans.
/// - VALIDATOR: só pode efetuar scans nos checkpoints que lhe estão associados.
enum Role {
  ADMIN
  CONTROLLER
  VALIDATOR
}

/// Utilizador autenticado, responsável por efetuar os scans.
model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(VALIDATOR)
  createdAt    DateTime     @default(now())
  scans        ScanEvent[]

  /// Checkpoints que este utilizador pode assumir quando faz scans (relevante para VALIDATOR).
  validatorCheckpoints Checkpoint[] @relation("ValidatorCheckpoints")
}

/// Registo de leitura de QR Code: máquina + checkpoint + utilizador + timestamp.
model ScanEvent {
  id           String     @id @default(cuid())
  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  checkpointId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  notes        String?
  timestamp    DateTime   @default(now())

  @@index([equipmentId])
  @@index([checkpointId])
  @@index([timestamp])
}
