// MoveControl — schema da base de dados
// Rastreio de movimentação de equipamentos entre datacenters via QR Code

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres — necessário para correr em Vercel (funções serverless têm
  // sistema de ficheiros efémero, por isso SQLite não funciona em produção).
  // Aponta DATABASE_URL para uma instância Postgres, tanto em dev como em prod
  // (ex: Vercel Postgres / Neon / Supabase — ver README).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Equipamento a movimentar. O hostname é o ID Único usado no QR Code.
/// Campos alinhados com a "Ficha de Equipamento" (formulário em papel usado
/// na migração física) para que a Vista de Impressão a possa reproduzir.
model Equipment {
  id           String      @id @default(cuid())
  hostname     String      @unique
  model        String?
  serialNumber String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scans        ScanEvent[]

  /// Identificador da "wave"/lote de migração a que este equipamento pertence.
  wave String?

  // — Dados do Equipamento —
  equipmentType   String? // Tipo Equipamento
  manufacturer    String? // Fabricante
  assetTag        String? // Etiqueta
  kvm             String? // KVM
  powerCables     String? // Cabos Power
  specialCables   String? // Cabos Especiais
  arms            String? // Braços
  powerLocation   String? // Localização Power
  cableConnection String? // Ligação Cabos
  rails           String? // Calhas

  // — Localização de Origem —
  originDatacenter String?
  originEp         String?
  originIsland     String? // Ilha
  originRack       String? // Bastidor
  originPosition   String? // Posição

  // — Localização de Destino —
  destinationDatacenter String?
  destinationIpTelecom  String? // IP Telecom
  destinationIsland     String?
  destinationRack       String?
  destinationPosition   String?

  ports        PortConnection[]
  palletItems  PalletItem[]
  palletEvents PalletEvent[]

  @@index([hostname])
}

/// Palete física que pode agrupar vários equipamentos para serem movidos em
/// conjunto numa fase da migração. Tem a sua própria ficha/QR: fazer scan do
/// QR da palete regista o checkpoint para todos os equipamentos lá dentro de
/// uma só vez.
model Pallet {
  id        String        @id @default(cuid())
  /// Código único da palete (ex: "PAL-0001") — é o conteúdo codificado no QR.
  code      String        @unique
  label     String?
  notes     String?
  createdAt DateTime      @default(now())
  items     PalletItem[]
  scans     ScanEvent[]
  /// Log de auditoria: equipamentos adicionados/removidos e checkpoints por
  /// onde a palete passou (quem fez, quando). É também a partir daqui que se
  /// deriva o estado atual da palete (último CHECKPOINT_SCAN).
  events    PalletEvent[]

  @@index([code])
}

/// Uma entrada do log de auditoria de uma Palete.
model PalletEvent {
  id       String          @id @default(cuid())
  pallet   Pallet          @relation(fields: [palletId], references: [id], onDelete: Cascade)
  palletId String
  type     PalletEventType

  /// Preenchido em ITEM_ADDED / ITEM_REMOVED — o equipamento em causa.
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentId String?

  /// Preenchido em CHECKPOINT_SCAN — o checkpoint atingido pela palete.
  checkpoint   Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  checkpointId String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  timestamp DateTime @default(now())

  /// Em CHECKPOINT_SCAN: true se o checkpoint foi definido manualmente por um
  /// ADMIN/CONTROLLER (sem scan físico do QR Code) — para rastreabilidade.
  manual Boolean @default(false)

  @@index([palletId])
  @@index([timestamp])
}

enum PalletEventType {
  ITEM_ADDED
  ITEM_REMOVED
  CHECKPOINT_SCAN
}

/// Associação entre uma Palete e um Equipamento (N-N).
model PalletItem {
  id          String    @id @default(cuid())
  pallet      Pallet    @relation(fields: [palletId], references: [id], onDelete: Cascade)
  palletId    String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  addedAt     DateTime  @default(now())

  @@unique([palletId, equipmentId])
  @@index([palletId])
  @@index([equipmentId])
}

/// Uma linha da tabela "Portas Ativas" da Ficha de Equipamento: um cabo/porta
/// ligando o equipamento de origem ao de destino (e respetivo patch panel).
model PortConnection {
  id          String    @id @default(cuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  order       Int // posição na tabela (1, 2, 3, …)

  /// Tipo de porta usada neste cabo.
  portType PortType?

  etiquetaOrigem       String? // Etiqueta Origem
  portaEtiquetaDestino String? // Porta/Etiqueta Equipamento Destino
  patchPanelOrigem     String? // Porta Patch Panel — Origem
  patchPanelDestino    String? // Porta Patch Panel — Destino

  @@index([equipmentId])
}

enum PortType {
  RJ45
  FIBRA
  OUTRAS
}

/// Ponto de controlo do processo de migração (ex: "Saída Origem",
/// "Em Trânsito", "Chegada Destino", "Instalado no Rack").
/// `order` define a posição na timeline — o maior valor é considerado
/// o checkpoint final (equipamento "Concluído").
model Checkpoint {
  id           String        @id @default(cuid())
  name         String
  order        Int           @unique
  description  String?
  createdAt    DateTime      @default(now())
  scans        ScanEvent[]
  palletEvents PalletEvent[]

  /// Utilizadores (VALIDATOR) autorizados a assumir este checkpoint.
  validators User[] @relation("ValidatorCheckpoints")
}

/// Papel de acesso do utilizador na aplicação.
/// - ADMIN: controlo total (utilizadores, checkpoints, equipamentos, scans).
/// - CONTROLLER: vê tudo exceto utilizadores; cria/apaga equipamentos e checkpoints; faz scans.
/// - VALIDATOR: só pode efetuar scans nos checkpoints que lhe estão associados.
enum Role {
  ADMIN
  CONTROLLER
  VALIDATOR
}

/// Utilizador autenticado, responsável por efetuar os scans.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(VALIDATOR)
  createdAt    DateTime      @default(now())
  scans        ScanEvent[]
  palletEvents PalletEvent[]

  /// Checkpoints que este utilizador pode assumir quando faz scans (relevante para VALIDATOR).
  validatorCheckpoints Checkpoint[] @relation("ValidatorCheckpoints")
}

/// Registo de leitura de QR Code: máquina + checkpoint + utilizador + timestamp.
model ScanEvent {
  id           String     @id @default(cuid())
  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  checkpointId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  notes        String?
  timestamp    DateTime   @default(now())

  /// Preenchido quando este scan resultou de um scan de Palete (em vez de um
  /// scan individual do equipamento) — para rastreabilidade na timeline.
  pallet   Pallet? @relation(fields: [palletId], references: [id], onDelete: SetNull)
  palletId String?

  /// true se o checkpoint foi definido manualmente por um ADMIN/CONTROLLER
  /// (sem scan físico do QR Code) — para rastreabilidade na timeline.
  manual Boolean @default(false)

  @@index([equipmentId])
  @@index([checkpointId])
  @@index([timestamp])
  @@index([palletId])
}
