# Connection string Postgres (dev e produção usam o mesmo provider).
# Ex: Neon/Vercel Postgres/Supabase — copia a connection string do dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Gera com: openssl rand -base64 33
AUTH_SECRET="define-uma-chave-secreta-aleatoria-aqui"
